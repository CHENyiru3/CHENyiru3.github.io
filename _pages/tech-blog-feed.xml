---
layout: none
permalink: /tech-blog/feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.title | default: site.first_name | append: " - Tech Blog" | xml_escape }}</title>
    <link>{{ '/tech-blog/' | absolute_url | xml_escape }}</link>
    <atom:link href="{{ '/tech-blog/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml" />
    <description>Technical notes on code, research tooling, computational workflows, and reproducible biomedical analysis.</description>
    <language>{{ site.lang | default: "en" | xml_escape }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>

    {% for post in site.posts %}
      {% assign is_tech_post = false %}
      {% if post.categories contains "tech-blog" or post.categories contains "tech" or post.tags contains "tech" %}
        {% assign is_tech_post = true %}
      {% endif %}

      {% if is_tech_post %}
        {% capture post_summary %}
          {% if post.description %}
            {{ post.description }}
          {% else %}
            {{ post.excerpt | strip_html }}
          {% endif %}
        {% endcapture %}
        <item>
          <title>{{ post.title | xml_escape }}</title>
          <link>{{ post.url | absolute_url | xml_escape }}</link>
          <guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
          <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
          <dc:creator>{{ site.first_name | append: " " | append: site.last_name | strip | xml_escape }}</dc:creator>
          <description>{{ post_summary | strip | strip_newlines | xml_escape }}</description>
          {% for tag in post.tags %}
            <category>{{ tag | xml_escape }}</category>
          {% endfor %}
          {% for category in post.categories %}
            <category>{{ category | xml_escape }}</category>
          {% endfor %}
        </item>
      {% endif %}
    {% endfor %}
  </channel>
</rss>
