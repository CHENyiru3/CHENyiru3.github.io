---
layout: none
permalink: /research-radar/feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | default: site.first_name | append: " - Research Radar" | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/research-radar/</link>
    <atom:link href="{{ site.url }}{{ site.baseurl }}/research-radar/feed.xml" rel="self" type="application/rss+xml" />
    <description>Daily ranked academic article recommendations from Research Radar.</description>
    <language>en</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>

    {% assign radar_digests = site.research_radar | sort: "date" | reverse %}
    {% for digest in radar_digests %}
      {% for article in digest.computational_articles %}
        <item>
          <title>{{ "[Computational #" | append: article.rank | append: "] " | append: article.title | xml_escape }}</title>
          <link>{{ article.url | default: digest.url | absolute_url | xml_escape }}</link>
          <guid isPermaLink="false">{{ digest.date | date: "%Y-%m-%d" }}-comp-{{ article.rank }}-{{ article.doi | default: article.url | xml_escape }}</guid>
          <pubDate>{{ digest.generated_at | default: digest.date | date_to_rfc822 }}</pubDate>
          <description>
            {{- "Section: Computational | Source: " | append: article.source | append: " | Published: " | append: article.published | append: " | DOI: " | append: article.doi | append: " | Recommendation: " | append: article.recommendation | append: " | Summary: " | append: article.summary | append: " | Why it matters: " | append: article.why_it_matters | xml_escape -}}
          </description>
          {% for topic in article.topics %}
            <category>{{ topic | xml_escape }}</category>
          {% endfor %}
        </item>
      {% endfor %}
      {% for article in digest.biomedicine_articles %}
        <item>
          <title>{{ "[Biomedicine #" | append: article.rank | append: "] " | append: article.title | xml_escape }}</title>
          <link>{{ article.url | default: digest.url | absolute_url | xml_escape }}</link>
          <guid isPermaLink="false">{{ digest.date | date: "%Y-%m-%d" }}-biomed-{{ article.rank }}-{{ article.doi | default: article.url | xml_escape }}</guid>
          <pubDate>{{ digest.generated_at | default: digest.date | date_to_rfc822 }}</pubDate>
          <description>
            {{- "Section: Biomedicine | Source: " | append: article.source | append: " | Published: " | append: article.published | append: " | DOI: " | append: article.doi | append: " | Recommendation: " | append: article.recommendation | append: " | Summary: " | append: article.summary | append: " | Why it matters: " | append: article.why_it_matters | xml_escape -}}
          </description>
          {% for topic in article.topics %}
            <category>{{ topic | xml_escape }}</category>
          {% endfor %}
        </item>
      {% endfor %}
      {% for article in digest.field_articles %}
        <item>
          <title>{{ "[Other Fields #" | append: article.rank | append: "] " | append: article.title | xml_escape }}</title>
          <link>{{ article.url | default: digest.url | absolute_url | xml_escape }}</link>
          <guid isPermaLink="false">{{ digest.date | date: "%Y-%m-%d" }}-field-{{ article.rank }}-{{ article.doi | default: article.url | xml_escape }}</guid>
          <pubDate>{{ digest.generated_at | default: digest.date | date_to_rfc822 }}</pubDate>
          <description>
            {{- "Section: Other Fields | Source: " | append: article.source | append: " | Published: " | append: article.published | append: " | DOI: " | append: article.doi | append: " | Recommendation: " | append: article.recommendation | append: " | Summary: " | append: article.summary | append: " | Why it matters: " | append: article.why_it_matters | xml_escape -}}
          </description>
          {% for topic in article.topics %}
            <category>{{ topic | xml_escape }}</category>
          {% endfor %}
        </item>
      {% endfor %}
      {% for article in digest.relevant_articles %}
        <item>
          <title>{{ "[Relevant #" | append: article.rank | append: "] " | append: article.title | xml_escape }}</title>
          <link>{{ article.url | default: digest.url | absolute_url | xml_escape }}</link>
          <guid isPermaLink="false">{{ digest.date | date: "%Y-%m-%d" }}-relevant-{{ article.rank }}-{{ article.doi | default: article.url | xml_escape }}</guid>
          <pubDate>{{ digest.generated_at | default: digest.date | date_to_rfc822 }}</pubDate>
          <description>
            {{- "Source: " | append: article.source | append: " | Published: " | append: article.published | append: " | DOI: " | append: article.doi | append: " | Recommendation: " | append: article.recommendation | append: " | Summary: " | append: article.summary | append: " | Why it matters: " | append: article.why_it_matters | xml_escape -}}
          </description>
          {% for topic in article.topics %}
            <category>{{ topic | xml_escape }}</category>
          {% endfor %}
        </item>
      {% endfor %}
      {% for article in digest.breakthrough_articles %}
        <item>
          <title>{{ "[Breakthrough #" | append: article.rank | append: "] " | append: article.title | xml_escape }}</title>
          <link>{{ article.url | default: digest.url | absolute_url | xml_escape }}</link>
          <guid isPermaLink="false">{{ digest.date | date: "%Y-%m-%d" }}-breakthrough-{{ article.rank }}-{{ article.doi | default: article.url | xml_escape }}</guid>
          <pubDate>{{ digest.generated_at | default: digest.date | date_to_rfc822 }}</pubDate>
          <description>
            {{- "Source: " | append: article.source | append: " | Published: " | append: article.published | append: " | DOI: " | append: article.doi | append: " | Recommendation: " | append: article.recommendation | append: " | Summary: " | append: article.summary | append: " | Why it matters: " | append: article.why_it_matters | xml_escape -}}
          </description>
          {% for topic in article.topics %}
            <category>{{ topic | xml_escape }}</category>
          {% endfor %}
        </item>
      {% endfor %}
    {% endfor %}
  </channel>
</rss>
