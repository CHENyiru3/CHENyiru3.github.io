---
layout: none
permalink: /research-radar/feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.title | default: site.first_name | append: " - Research Radar" | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/research-radar/</link>
    <atom:link href="{{ site.url }}{{ site.baseurl }}/research-radar/feed.xml" rel="self" type="application/rss+xml" />
    <description>Daily academic article recommendations — maintained by Clawdie, driven by Hermes + DeepSeek-V4-Pro.</description>
    <language>en</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>

    {% assign radar_digests = site.research_radar | sort: "date" | reverse %}
    {% for digest in radar_digests %}
      {% for article in digest.computational_articles %}
        {% include research_radar_item.xml article=article digest=digest section="Computational" %}
      {% endfor %}
      {% for article in digest.biomedicine_articles %}
        {% include research_radar_item.xml article=article digest=digest section="Biomedicine" %}
      {% endfor %}
      {% for article in digest.field_articles %}
        {% include research_radar_item.xml article=article digest=digest section="Other Fields" %}
      {% endfor %}
      {% for article in digest.relevant_articles %}
        {% include research_radar_item.xml article=article digest=digest section="Relevant" %}
      {% endfor %}
      {% for article in digest.breakthrough_articles %}
        {% include research_radar_item.xml article=article digest=digest section="Breakthrough" %}
      {% endfor %}
    {% endfor %}
  </channel>
</rss>
