{% assign digest = include.digest %}
{% assign computational_articles = digest.computational_articles %}
{% assign biomedicine_articles = digest.biomedicine_articles %}
{% assign field_articles = digest.field_articles %}
{% assign relevant_articles = digest.relevant_articles %}
{% assign breakthrough_articles = digest.breakthrough_articles %}
{% assign hot_topic = digest.hot_topic %}
{% assign comp_count = 0 %}
{% assign biomed_count = 0 %}
{% assign field_count = 0 %}
{% assign rel_count = 0 %}
{% assign brk_count = 0 %}
{% if computational_articles %}
  {% assign comp_count = computational_articles | size %}
{% endif %}
{% if biomedicine_articles %}
  {% assign biomed_count = biomedicine_articles | size %}
{% endif %}
{% if field_articles %}
  {% assign field_count = field_articles | size %}
{% endif %}
{% if relevant_articles %}
  {% assign rel_count = relevant_articles | size %}
{% endif %}
{% if breakthrough_articles %}
  {% assign brk_count = breakthrough_articles | size %}
{% endif %}

<div class="research-radar-meta">
  {% if digest.generated_at %}
    <span>Generated {{ digest.generated_at }}</span>
  {% endif %}
  {% if digest.provider %}
    <span>{{ digest.provider }}</span>
  {% endif %}
  {% if digest.scope %}
    <span>{{ digest.scope }}</span>
  {% endif %}
</div>

{% if hot_topic %}
  <aside class="research-radar-hot-topic">
    <p class="research-radar-kicker">Hot Topic</p>
    {% if hot_topic.title %}
      <h2>{{ hot_topic.title }}</h2>
    {% else %}
      <h2>{{ hot_topic }}</h2>
    {% endif %}
    {% if hot_topic.summary %}
      <p>{{ hot_topic.summary }}</p>
    {% endif %}
    {% if hot_topic.signals %}
      <ul>
        {% for signal in hot_topic.signals %}
          <li>{{ signal }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </aside>
{% endif %}

{% if comp_count > 0 %}
  <section class="research-radar-section research-radar-section-relevant">
    <div class="research-radar-section-heading">
      <div>
        <p class="research-radar-kicker">Methods & AI</p>
        <h2>Computational</h2>
      </div>
      <span class="research-radar-count">{{ comp_count }} selected</span>
    </div>
    {% for article in computational_articles %}
      {% include research_radar_article.liquid article=article section_label="Computational" %}
    {% endfor %}
  </section>
{% endif %}

{% if biomed_count > 0 %}
  <section class="research-radar-section research-radar-section-relevant">
    <div class="research-radar-section-heading">
      <div>
        <p class="research-radar-kicker">Biomedical discoveries</p>
        <h2>Biomedicine</h2>
      </div>
      <span class="research-radar-count">{{ biomed_count }} selected</span>
    </div>
    {% for article in biomedicine_articles %}
      {% include research_radar_article.liquid article=article section_label="Biomedicine" %}
    {% endfor %}
  </section>
{% endif %}

{% if field_count > 0 %}
  <section class="research-radar-section research-radar-section-breakthrough">
    <div class="research-radar-section-heading">
      <div>
        <p class="research-radar-kicker">Cross-disciplinary watchlist</p>
        <h2>Other Fields</h2>
      </div>
      <span class="research-radar-count">{{ field_count }} selected</span>
    </div>
    {% for article in field_articles %}
      {% include research_radar_article.liquid article=article section_label="Field" %}
    {% endfor %}
  </section>
{% endif %}

{% if rel_count > 0 %}
  <section class="research-radar-section research-radar-section-relevant">
    <div class="research-radar-section-heading">
      <div>
        <p class="research-radar-kicker">Core signal</p>
        <h2>Top {{ rel_count }} Relevant Reads</h2>
      </div>
      <span class="research-radar-count">{{ rel_count }} selected</span>
    </div>
    {% for article in relevant_articles %}
      {% include research_radar_article.liquid article=article section_label="Relevant" %}
    {% endfor %}
  </section>
{% endif %}

{% if brk_count > 0 %}
  <section class="research-radar-section research-radar-section-breakthrough">
    <div class="research-radar-section-heading">
      <div>
        <p class="research-radar-kicker">Broader watchlist</p>
        <h2>Top {{ brk_count }} Field Breakthroughs</h2>
      </div>
      <span class="research-radar-count">{{ brk_count }} selected</span>
    </div>
    {% for article in breakthrough_articles %}
      {% include research_radar_article.liquid article=article section_label="Breakthrough" %}
    {% endfor %}
  </section>
{% endif %}
