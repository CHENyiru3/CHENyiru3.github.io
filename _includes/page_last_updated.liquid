{% unless page.show_page_last_updated == false %}
  {% assign page_last_updated = page.page_last_updated | default: page.last_updated | default: page.date | default: site.time %}
  <div class="page-last-updated">
    Page Last Updated:
    <time datetime="{{ page_last_updated | date_to_xmlschema }}">{{ page_last_updated | date: "%B %d, %Y" }}</time>
  </div>
{% endunless %}
