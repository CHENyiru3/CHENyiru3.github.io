{% assign article = include.article %}
{% assign digest = include.digest %}
{% assign section = include.section %}
{% assign article_link = article.url | default: digest.url | absolute_url %}
{% assign guid = digest.date | date: "%Y-%m-%d" | append: "-" | append: section | append: "-" | append: article.rank %}
{% assign article_doi = article.doi %}
{% if article_doi == "" %}
  {% assign article_doi = nil %}
{% endif %}
<item>
  <title>[{{ section }} #{{ article.rank }}] {{ article.title | xml_escape }}</title>
  <link>{{ article_link | xml_escape }}</link>
  <guid isPermaLink="false">{{ guid | xml_escape }}</guid>
  <pubDate>{{ digest.generated_at | default: digest.date | date_to_rfc822 }}</pubDate>
  <dc:creator>{{ article.authors | xml_escape }}</dc:creator>
  <description><![CDATA[
    <p><strong>{{ article.title | xml_escape }}</strong></p>
    <p>{{ article.authors | xml_escape }} &middot; <em>{{ article.source | xml_escape }}</em> &middot; {{ article.published | xml_escape }} &middot; {{ article.article_type | xml_escape }}</p>
    {% if article_doi %}<p>DOI: <a href="https://doi.org/{{ article_doi | xml_escape }}">{{ article_doi | xml_escape }}</a></p>{% endif %}
    {% if article.url and article.url != "" %}<p>🔗 <a href="{{ article.url | xml_escape }}">{{ article.url | xml_escape }}</a></p>{% endif %}
    <hr>
    <p><strong>Summary</strong><br>{{ article.summary | xml_escape }}</p>
    <p><strong>Why it matters</strong><br>{{ article.why_it_matters | xml_escape }}</p>
    <p><strong>Why for Yiru</strong><br>{{ article.why_for_me | xml_escape }}</p>
    <hr>
    <p>📋 {{ article.recommendation | xml_escape }}</p>
  ]]></description>
  {% for topic in article.topics %}
    <category>{{ topic | xml_escape }}</category>
  {% endfor %}
</item>
